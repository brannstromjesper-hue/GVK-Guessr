# PostgreSQL-yhteys (Railway Postgres URL, esim. postgresql://...)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Istuntojen allekirjoitusavain. Aseta sama arvo kaikissa ympäristöissä,
# jotka ajavat /api-reittejä (esim. Vercel ja Railway).
# openssl rand -base64 32
AUTH_SECRET="korvaa-pitkalla-satunnaisella-merkkijonolla"

# Vanha NextAuth-nimi on tuettu siirtymän ajan; käytä mieluiten AUTH_SECRET.
# NEXTAUTH_SECRET="sama-arvo-kuin-AUTH_SECRET"

# Sovelluksen URL (ei kauttaviivaa lopussa)
AUTH_URL="http://localhost:3000"

# Julkinen API-osoite frontendin fetch-kutsuille (esim. Railway backend)
NEXT_PUBLIC_API_BASE_URL=""

# Oikea kohde — vain palvelimella, ei selaimelle
REAL_LAT="60.1699"
REAL_LNG="24.9384"

# Alkuperäinen jäsenlista. Kun tietokanta on luotu, hallinta /admin-sivulla.
# Käytä | erottimena jos nimissä on pilkkuja.
MEMBERS="Teppo|Ola Nordmann|Kari Nordmann|Per Askeladden"

# Alkuperäiset ylläpitäjät (sama erotinlogiikka kuin MEMBERS).
ADMIN_NAMES="Teppo"
