# PostgreSQL-yhteys (Railway Postgres URL, esim. postgresql://...)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Supabase Auth. SUPABASE_SERVICE_ROLE_KEY ja
# SUPABASE_MEMBER_PASSWORD_SECRET ovat vain palvelimelle.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_ANON_KEY="supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="supabase-service-role-key"
# openssl rand -base64 32
SUPABASE_MEMBER_PASSWORD_SECRET="korvaa-pitkalla-satunnaisella-merkkijonolla"
# Valinnainen: domain automaattisesti luoduille jäsenkäyttäjille.
SUPABASE_AUTH_EMAIL_DOMAIN="auth.gvk-guessr.local"

# Sovelluksen URL (ei kauttaviivaa lopussa)
AUTH_URL="http://localhost:3000"

# Julkinen API-osoite frontendin fetch-kutsuille (esim. Railway backend)
NEXT_PUBLIC_API_BASE_URL=""

# Oikea kohde — vain palvelimella, ei selaimelle
REAL_LAT="60.1699"
REAL_LNG="24.9384"

