generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guess {
  id          String   @id @default(cuid())
  memberKey   String   @unique
  memberName  String
  lat         Float
  lng         Float
  distanceKm  Float
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
