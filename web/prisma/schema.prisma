generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guess {
  id          String   @id @default(cuid())
  memberKey   String   @unique
  memberName  String
  lat         Float
  lng         Float
  distanceKm  Float
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
